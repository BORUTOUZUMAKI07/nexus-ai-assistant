# ╔═══════════════════════════════════════════════════════════════════════════╗
# ║           NEXUS AI ASSISTANT – ENVIRONMENT VARIABLES TEMPLATE            ║
# ║  Copy this file to .env and fill in your real values.                    ║
# ║  NEVER commit .env to source control.                                    ║
# ╚═══════════════════════════════════════════════════════════════════════════╝

# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL with asyncpg driver (pgvector extension required)
DATABASE_URL=postgresql+asyncpg://nexus:nexus@localhost:5432/nexus_dev

# ─── Redis ────────────────────────────────────────────────────────────────────
# Used by: Celery broker, result backend, LiteLLM in-memory cache
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ─── Qdrant ───────────────────────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
# Leave blank if using local Qdrant without auth
QDRANT_API_KEY=

# ─── LLM Providers ────────────────────────────────────────────────────────────
# At least one API key is required. Keys for multiple providers enable
# LiteLLM Router fallback tiers. Free tiers:
# - Groq: https://console.groq.com/  (llama-3.3-70b-versatile)
# - Gemini: https://aistudio.google.com/  (gemini-1.5-flash)
# - Together: https://api.together.ai/  (llama-3.3-70b-turbo)
GROQ_API_KEY=
GEMINI_API_KEY=
TOGETHER_API_KEY=
OPENAI_API_KEY=         # Optional – used for embeddings if Groq is primary LLM
ANTHROPIC_API_KEY=      # Optional – Claude models for code tasks

# ─── Embedding Model ──────────────────────────────────────────────────────────
# Default uses free-tier Groq embeddings. Alternatives: openai/text-embedding-3-small
EMBEDDING_MODEL=text-embedding-ada-002
EMBEDDING_DIMENSION=1536

# ─── Firecrawl v2 ─────────────────────────────────────────────────────────────
# https://firecrawl.dev – Web scraping, crawling, and extraction
FIRECRAWL_API_KEY=

# ─── E2B Code Interpreter ─────────────────────────────────────────────────────
# https://e2b.dev – Sandboxed code execution in microVMs
E2B_API_KEY=

# ─── MinIO (Object Storage) ───────────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=nexus
MINIO_SECRET_KEY=nexuspassword
MINIO_BUCKET_NAME=nexus-files
MINIO_SECURE=false

# ─── Auth & Security ──────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=changeme_generate_a_real_secret_key_here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ─── FastAPI App ──────────────────────────────────────────────────────────────
ENVIRONMENT=development     # development | staging | production
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]
# Max file upload size in MB
MAX_UPLOAD_SIZE_MB=50

# ─── FastMCP ──────────────────────────────────────────────────────────────────
MCP_SERVER_NAME=nexus-mcp
MCP_SERVER_VERSION=1.0.0

# ─── Celery ───────────────────────────────────────────────────────────────────
CELERY_WORKER_CONCURRENCY=4
CELERY_TASK_SOFT_TIME_LIMIT=300    # 5 minutes
CELERY_TASK_TIME_LIMIT=600         # 10 minutes (hard limit)

# ─── RAG ──────────────────────────────────────────────────────────────────────
QDRANT_COLLECTION_NAME=nexus_knowledge
RAG_TOP_K=20          # Number of candidates before reranking
RAG_RERANK_TOP_N=5    # Final number of results after FlashRank reranking
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# ─── Frontend (Next.js) ───────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=Nexus AI
