# ==========================================
# NEXUS AI ASSISTANT — ENVIRONMENT CONFIGURATION
# ==========================================

# Application Environment
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
# ⚠ The two values below are published in this repository. They are placeholders,
# NOT secrets. The app refuses to start with ENVIRONMENT=production while either
# one is still set to its example text, and replaces them with fresh random
# values in development. Generate your own for any shared environment, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-super-secret-hex-key-in-production-min-32-chars
ENCRYPTION_KEY=super-secret-aes256-encryption-key-for-byok-keys-32bytes

# Database & Supabase (PostgreSQL + Storage + auth)
#
# The three parts must agree with the `postgres` service in docker-compose.yml:
# POSTGRES_USER=nexus, POSTGRES_PASSWORD=nexus, POSTGRES_DB=nexus_dev. They did
# not once (this line said postgres:postgres@/nexus_db) and the mismatch fails
# at connect time, so both obvious first-run paths were broken:
# copying this file to `.env` could not reach the container, and leaving `.env`
# alone pointed every run at whatever DATABASE_URL was already there.
# `tests/test_env_example_matches_compose.py` now fails if they drift again.
#
# Leave this pointing at localhost for development. `alembic upgrade` and
# `alembic downgrade` REFUSE a non-local host unless ALLOW_REMOTE_MIGRATIONS is
# set (see below), and the app logs a warning on every boot when the target is
# remote, because init_db() issues CREATE TABLE for anything missing.
DATABASE_URL=postgresql+asyncpg://nexus:nexus@localhost:5432/nexus_dev
# SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY are also what object storage uses (see
# STORAGE_BUCKET below). Only the service-role (admin) key belongs on a server.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Set to 1 ONLY on a machine that is deliberately migrating a hosted database.
# `alembic upgrade` / `alembic downgrade` exit with an error rather than touch a
# non-local target without it; read-only commands are unaffected. Required in
# CI or any deploy job that migrates a real database.
# ALLOW_REMOTE_MIGRATIONS=1

# Optional. DSN for LangGraph's checkpoint memory, when it must differ from
# DATABASE_URL. Leave unset unless you are on a connection pooler.
#
# The two have opposite connection-lifetime needs. The SQLAlchemy engine uses
# NullPool (a fresh connection per request), so it is immune to a pooler
# closing idle sockets. The checkpointer holds ONE connection for the whole
# process, because AsyncPostgresSaver has no pool API — so on a transaction-mode
# pooler (Supabase port 6543, pgbouncer) that socket can be reaped while idle
# and the next chat message dies on its first read with
# "server closed the connection unexpectedly".
#
# If your DATABASE_URL uses port 6543, graph.py automatically upgrades the port
# to 5432 (session mode) for the checkpointer only, and logs a WARNING saying
# so. Set this explicitly to pin the behaviour and silence that warning:
#
#   LANGGRAPH_CHECKPOINT_DSN=postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# Note the username: on the pooler it is `postgres.<project-ref>`, and there is
# no `+asyncpg` driver suffix (psycopg3 needs the plain form).
# LANGGRAPH_CHECKPOINT_DSN=

# Browser allow-list for the API (comma-separated). The frontend reaches the
# backend only through its own /api proxy, but anything calling the API
# cross-origin (Playwright, a mobile build, a custom client) must be listed.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Upstash Redis & Celery
REDIS_URL=redis://localhost:6379/0

# Qdrant Vector Cloud
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=your-qdrant-cloud-api-key

# LLM Providers (All Free Tier Compatible)
GROQ_API_KEY=gsk_your_groq_api_key_here
OPENROUTER_API_KEY=sk-or-your_openrouter_api_key_here
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Sandboxing & Web Research
E2B_API_KEY=e2b_your_e2b_api_key_here
FIRECRAWL_API_KEY=fc-your_firecrawl_api_key_here
TAVILY_API_KEY=tvly-your_tavily_api_key_here

# Embedding Model — MUST be kept in lock-step with EMBEDDING_DIMENSION (the
# Qdrant collection is created with this exact vector size; a mismatch triggers
# collection recreation or ingestion failures). Default is Gemini @ 768.
# Embeddings and reranking both go through the LiteLLM router, so they need an
# API key for whichever provider serves the model above — there is no local
# HuggingFace download and no HUGGINGFACE_API_KEY to set.
EMBEDDING_MODEL=models/gemini-embedding-001
EMBEDDING_DIMENSION=768

# Retrieval — HyDE (Hypothetical Document Embeddings)
# For an abstract question the model first *imagines the answer*, and that
# imagined passage is what gets embedded and searched. That is the point: a
# question and its answer share little wording, so the question alone retrieves
# passages that are on-topic but never contain the answer.
#   llm       - generate the hypothesis (default)
#   template  - no model call; the old fixed "An overview of <query>..." string,
#               which embeds close to the query itself and mostly re-finds what
#               variant #1 already did
#   off       - skip HyDE, keep only the deterministic lexical expansions
# `template` and `off` exist so the cost/benefit is measurable by flipping one
# variable instead of reverting code. Code/keyword lookups never call the model
# either way — see the gate in services/rag/query_rewriter.py.
# RAG_HYDE_MODE=llm
# One short hypothesis per abstract query, on the query path: keep it cheap, and
# cap the length and the wait, because retrieval must not block on generation.
# RAG_HYDE_MODEL=fast_chat
# RAG_HYDE_MAX_TOKENS=220
# RAG_HYDE_TIMEOUT_SECONDS=6.0

# --- Typed decisions + answer coverage ---------------------------------------
# services/decision.py turns a closed-set question into a decision and, where the
# provider supplies logprobs, a real probability read off the model's own scores.
# It never asks a model how confident it is: that returns a number the model
# invented. With no logprobs the decision falls back to a caller rule (or nothing)
# and reports NO probability at all, which is what stops a heuristic from being
# promoted into a calibrated-looking score.
#
# One word out, so keep it on a cheap model. The distribution is read at the first
# generated token, so DECISION_MAX_TOKENS is a hard cost ceiling, not a suggestion.
# DECISION_MODEL=fast_chat
# DECISION_MAX_TOKENS=8
# DECISION_TIMEOUT_SECONDS=6.0
# Alternatives requested per token; providers cap this and drop the request if it
# is out of range, and a dropped request is the normal case, not an error.
# DECISION_TOP_LOGPROBS=20
#
# Answer coverage is the first consumer: hybrid search, FlashRank reranking and MMR
# all rank by *similarity*, so a passage about the wrong version of the right thing
# scores well and gets cited. This grades whether a passage actually *answers* the
# question, and drops those that do not -- but only ever on a real measurement. A
# decision that fell back to a rule, or could not be made, keeps its chunk: an extra
# citation is recoverable, a missing one is not.
#
# OFF by default, and that is a cost decision, not a correctness one. It adds one
# cheap model call per graded chunk on the query path, and whether that buys more
# than it costs is measurable only against real queries. Turn it on, then read the
# rag_answer_coverage_graded log line: if measured is 0, your provider is not
# returning logprobs and nothing will ever be dropped.
# RAG_ANSWER_COVERAGE_ENABLED=false
# Only the best reranked chunks are graded; grading all top_k costs more to reach
# the same answer, because chunks below the cut rank below ones that survive.
# RAG_ANSWER_COVERAGE_TOP_N=5
# A measured `partially` below this is dropped. A measured `does_not_answer` is
# dropped regardless -- it is a distractor, not thin evidence.
# RAG_ANSWER_COVERAGE_DROP_BELOW=0.6
# RAG_ANSWER_COVERAGE_CHARS=1200

# Object Storage — Supabase Storage over its REST API (infrastructure/storage/
# supabase_storage.py). There are no S3/R2/MinIO credentials: the boto3 layer
# was removed, and any S3_* key you set is ignored. The service-role key above
# authenticates every call; this is just the bucket name.
STORAGE_BUCKET=nexus-knowledge

# Observability & Monitoring (Free Tiers)
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=nexus-ai-assistant
SENTRY_DSN=

# ── MCP server (/mcp) ──────────────────────────────────────────────────────
# FastMCP is mounted at /mcp and gated by MCP_AUTH_ENABLED (default true): a
# request must carry a Bearer JWT, the nexus_access_token cookie, or this shared
# key in the x-nexus-mcp-key header. Set a key before exposing /mcp publicly.
MCP_AUTH_ENABLED=true
MCP_API_KEY=

# New Relic (free tier) — 3-layer observability. The in-process /metrics is the
# local source of truth (the Layer-2 collector scrapes it); the app ALSO pushes
# structured logs over OTLP/HTTP to the collector (docker-compose
# `otel-collector`, or the Render web service in render.yaml), which owns
# NEW_RELIC_LICENSE_KEY and forwards to New Relic. Requires the [observability]
# extras (opentelemetry-sdk + OTLP HTTP exporter). No-op when off or when the
# extras are not installed.
NEW_RELIC_ENABLED=false
# Layer-2 collector OTLP/HTTP base URL. Local: http://localhost:4318 (the
# docker-compose collector). Prod: your Render collector URL (https://...onrender.com).
NEW_RELIC_OTLP_ENDPOINT=http://localhost:4318
NEW_RELIC_EXPORT_INTERVAL_SECONDS=30

# PII Redaction (log hygiene — scrub emails/phones/SSNs/secrets from logs)
PII_REDACTION_ENABLED=false

# ── Long-term memory (mem0) ─────────────────────────────────────────────────
# Unset = the in-process/SQLite memory backend is used and the app runs without
# it. Set a mem0 Cloud key to get managed, cross-session memory.
MEM0_API_KEY=

# Response Cache (exact-normalized query replay; fails open)
RESPONSE_CACHE_ENABLED=false
RESPONSE_CACHE_TTL_SECONDS=3600

# Canary/Shadow Experiments (safe release). Point at a YAML file with
# experiment definitions; unset = experiments resolve to their default variant.
EXPERIMENTS_CONFIG_PATH=

# Security & Rate Limiting (Manual Custom JWT Auth)
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
RATE_LIMIT_PER_MINUTE=100

# How long a duplicate refresh-token exchange is treated as a two-tab race rather
# than as theft. Inside the window the duplicate is answered with the tokens the
# first exchange already issued; outside it the replay is refused and that
# sign-in's token family is revoked. Set to 0 to restore strict single-use.
REFRESH_REUSE_GRACE_SECONDS=10

# Transactional Email (Free Gmail SMTP or Resend)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_digit_gmail_app_password
SMTP_TLS=true
EMAIL_FROM=noreply@nexus-assistant.ai
RESEND_API_KEY=

# ── Two-Factor Authentication (TOTP, RFC 6238) ──────────────────────────────
# Enforced per-user via the /auth/2fa/setup flow; login returns a "preauth"
# challenge token the client exchanges at /auth/2fa/verify for real JWTs.
TOTP_ISSUER="Nexus AI Assistant"
TOTP_VALID_WINDOW=1
TOTP_PREAUTH_MINUTES=5

# ── OAuth / SSO (Google + GitHub, Authorization Code + PKCE) ───────────────
# Leave a client id empty to disable that provider (/auth/oauth/{provider} then
# 404s and the signin page hides its button). Redirect URIs must be registered
# with the provider exactly as configured here — the defaults are the local-dev
# backend origin; in production point them through the BFF
# (https://app.example.com/api/auth/oauth/{provider}/callback) so the browser
# never talks to the FastAPI origin directly.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/oauth/google/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/oauth/github/callback

# ── Email verification & password reset ─────────────────────────────────────
# EMAIL_VERIFICATION_REQUIRED=false keeps the current free-tier flow unchanged
# (accounts authenticate immediately). When true, /auth/verify-email is
# enforced at login. Links are built from APP_PUBLIC_URL and prefixed by a
# signed JWT carrying the token purpose.
EMAIL_VERIFICATION_REQUIRED=false
EMAIL_VERIFY_TOKEN_MINUTES=1440
PASSWORD_RESET_TOKEN_MINUTES=30
APP_PUBLIC_URL=http://localhost:3000

# ── Outbound webhooks ───────────────────────────────────────────────────────
# Per-endpoint HMAC secret + X-Nexus-Signature; deliveries retried until they
# reach this attempt cap (worker: retry_webhook_deliveries_task).
WEBHOOK_MAX_ATTEMPTS=3

# ── Read-only share links ───────────────────────────────────────────────────
# Optional global expiry for freshly minted /public/shares/{token} links.
SHARE_DEFAULT_TTL_SECONDS=

# ── Text-to-Speech (edge-tts) ─────────────────────────────────────────────────
# Key-less Microsoft Edge neural voices — free, no API key, no billing.
# TTS_VOICE is an edge-tts voice id (e.g. en-US-AriaNeural, en-US-GuyNeural).
TTS_MODEL=edge-tts
TTS_VOICE=en-US-AriaNeural
TTS_FORMAT=mp3
