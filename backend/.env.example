# ==========================================
# NEXUS AI ASSISTANT — ENVIRONMENT CONFIGURATION
# ==========================================

# Application Environment
ENVIRONMENT=development
APP_NAME="Nexus AI Assistant"
API_V1_STR=/api/v1
SECRET_KEY=change-this-to-a-super-secret-hex-key-in-production-min-32-chars
ENCRYPTION_KEY=super-secret-aes256-encryption-key-for-byok-keys-32bytes
ALLOWED_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# Database & Supabase PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/nexus_db
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Upstash Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Qdrant Vector Cloud
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=your-qdrant-cloud-api-key

# LLM Providers (All Free Tier Compatible)
GROQ_API_KEY=gsk_your_groq_api_key_here
OPENROUTER_API_KEY=sk-or-your_openrouter_api_key_here
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Sandboxing & Web Research
E2B_API_KEY=e2b_your_e2b_api_key_here
FIRECRAWL_API_KEY=fc-your_firecrawl_api_key_here
TAVILY_API_KEY=tvly-your_tavily_api_key_here

# Embeddings & HuggingFace
HUGGINGFACE_API_KEY=hf_your_huggingface_api_key_here

# Embedding Model — MUST be kept in lock-step with EMBEDDING_DIMENSION (the
# Qdrant collection is created with this exact vector size; a mismatch triggers
# collection recreation or ingestion failures). Default is Gemini @ 768.
EMBEDDING_MODEL=models/gemini-embedding-001
EMBEDDING_DIMENSION=768

# Object Storage (Cloudflare R2 recommended - 10GB free & $0 egress, or Supabase S3)
S3_ENDPOINT_URL=https://<your_account_id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=your_r2_or_s3_access_key_id
S3_SECRET_ACCESS_KEY=your_r2_or_s3_secret_access_key
S3_BUCKET_NAME=nexus-knowledge
S3_REGION_NAME=auto

# Observability & Monitoring (Free Tiers)
HELICONE_API_KEY=
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=nexus-ai-assistant
SENTRY_DSN=

# Langfuse (optional, industry-standard trace/cost observability).
# Enable + provide keys to route every LiteLLM completion/stream through
# Langfuse (token+cost-per-trace, latency, failure tracking). No-op when off.
LANGFUSE_ENABLED=false
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# PII Redaction (log hygiene — scrub emails/phones/SSNs/secrets from logs)
PII_REDACTION_ENABLED=false

# Response Cache (exact-normalized query replay; fails open)
RESPONSE_CACHE_ENABLED=false
RESPONSE_CACHE_TTL_SECONDS=3600

# Canary/Shadow Experiments (MD §6.6 safe release). Point at a YAML file with
# experiment definitions; unset = experiments resolve to their default variant.
EXPERIMENTS_CONFIG_PATH=

# Security & Rate Limiting (Manual Custom JWT Auth)
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_STREAM_COST=5

# Transactional Email (Free Gmail SMTP or Resend)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_digit_gmail_app_password
SMTP_TLS=true
EMAIL_FROM=noreply@nexus-assistant.ai
RESEND_API_KEY=

# ── Two-Factor Authentication (TOTP, RFC 6238) ──────────────────────────────
# Enforced per-user via the /auth/2fa/setup flow; login returns a "preauth"
# challenge token the client exchanges at /auth/2fa/verify for real JWTs.
TOTP_ISSUER="Nexus AI Assistant"
TOTP_VALID_WINDOW=1
TOTP_PREAUTH_MINUTES=5

# ── Email verification & password reset ─────────────────────────────────────
# EMAIL_VERIFICATION_REQUIRED=false keeps the current free-tier flow unchanged
# (accounts authenticate immediately). When true, /auth/verify-email is
# enforced at login. Links are built from APP_PUBLIC_URL and prefixed by a
# signed JWT carrying the token purpose.
EMAIL_VERIFICATION_REQUIRED=false
EMAIL_VERIFY_TOKEN_MINUTES=1440
PASSWORD_RESET_TOKEN_MINUTES=30
APP_PUBLIC_URL=http://localhost:3000

# ── Outbound webhooks ───────────────────────────────────────────────────────
# Per-endpoint HMAC secret + X-Nexus-Signature; deliveries retried until they
# reach this attempt cap (worker: retry_webhook_deliveries_task).
WEBHOOK_MAX_ATTEMPTS=3

# ── Read-only share links ───────────────────────────────────────────────────
# Optional global expiry for freshly minted /public/shares/{token} links.
SHARE_DEFAULT_TTL_SECONDS=

# ── Text-to-Speech (edge-tts) ─────────────────────────────────────────────────
# Key-less Microsoft Edge neural voices — free, no API key, no billing.
# TTS_VOICE is an edge-tts voice id (e.g. en-US-AriaNeural, en-US-GuyNeural).
TTS_MODEL=edge-tts
TTS_VOICE=en-US-AriaNeural
TTS_FORMAT=mp3
