# ==========================================
# NEXUS AI ASSISTANT — ENVIRONMENT CONFIGURATION
# ==========================================

# Application Environment
ENVIRONMENT=development
APP_NAME="Nexus AI Assistant"
API_V1_STR=/api/v1
SECRET_KEY=change-this-to-a-super-secret-hex-key-in-production-min-32-chars
ENCRYPTION_KEY=super-secret-aes256-encryption-key-for-byok-keys-32bytes
ALLOWED_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# Database & Supabase PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/nexus_db
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Upstash Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Qdrant Vector Cloud
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=your-qdrant-cloud-api-key

# LLM Providers (All Free Tier Compatible)
GROQ_API_KEY=gsk_your_groq_api_key_here
OPENROUTER_API_KEY=sk-or-your_openrouter_api_key_here
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Sandboxing & Web Research
E2B_API_KEY=e2b_your_e2b_api_key_here
FIRECRAWL_API_KEY=fc-your_firecrawl_api_key_here
TAVILY_API_KEY=tvly-your_tavily_api_key_here

# Embeddings & HuggingFace
HUGGINGFACE_API_KEY=hf_your_huggingface_api_key_here

# Object Storage (Cloudflare R2 recommended - 10GB free & $0 egress, or Supabase S3)
S3_ENDPOINT_URL=https://<your_account_id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=your_r2_or_s3_access_key_id
S3_SECRET_ACCESS_KEY=your_r2_or_s3_secret_access_key
S3_BUCKET_NAME=nexus-knowledge
S3_REGION_NAME=auto

# Observability & Monitoring (Free Tiers)
HELICONE_API_KEY=
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=nexus-ai-assistant
SENTRY_DSN=

# Security & Rate Limiting (Manual Custom JWT Auth)
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_STREAM_COST=5

# Transactional Email (Free Gmail SMTP or Resend)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_digit_gmail_app_password
SMTP_TLS=true
EMAIL_FROM=noreply@nexus-assistant.ai
RESEND_API_KEY=
